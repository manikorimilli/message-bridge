# Copy this file to .env and fill in your values. .env is git-ignored; never commit it.

# Optional. If set, callers must send it in the X-API-Key header. Generate one with: openssl rand -hex 32
# Leave empty to let anyone call the API (fine for a quick demo, risky on a public URL).
API_KEY=

# Get these from the Twilio Console: Account SID on the dashboard, API key under Account > API keys.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Your Twilio phone number in E.164 format, e.g. +14155550100
TWILIO_FROM_NUMBER=

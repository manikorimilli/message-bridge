# Optional. Leave unset to call the API through the same origin (/v1/...), which the Vite
# dev server and vercel.json forward to https://message-bridge.onrender.com (no CORS needed).
# Set it only to call another API directly, e.g. a local backend: http://localhost:8080
# VITE_ variables are built into the public bundle, so never put a secret here.
# VITE_API_URL=http://localhost:8080
